meta {
  name: Coach may not create teams
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/teams
  body: json
  auth: inherit
}

body:json {
  {
    "name": "not-allowed",
    "coaches": []
  }
}

tests {
  test("responds with 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
