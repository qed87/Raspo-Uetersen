meta {
  name: Create Team
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/teams
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{teamName}}",
    "coaches": [
      "{{coachEmail}}"
    ]
  }
}

script:post-response {
  bru.setVar("teamId", res.body.Data);
}

tests {
  test("responds with 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Admins only. The club is read from the configuration, the stream is named team-{teamId}, the team id is a new UUID. The team name must be unique within the club.
}
