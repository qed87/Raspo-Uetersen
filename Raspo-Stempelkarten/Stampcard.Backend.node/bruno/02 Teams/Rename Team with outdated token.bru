meta {
  name: Rename Team with outdated token
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/teams/{{teamId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{teamName}}-outdated",
    "concurrencyToken": {{concurrencyToken}}
  }
}

tests {
  test("responds with 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
