meta {
  name: Update Player with outdated token
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/teams/{{teamId}}/player/{{playerId}}
  body: json
  auth: inherit
}

body:json {
  {
    "firstName": "Max",
    "lastName": "Mustermann",
    "birthdate": "2017-03-04",
    "concurrencyToken": {{outdatedConcurrencyToken}}
  }
}

tests {
  test("responds with 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
