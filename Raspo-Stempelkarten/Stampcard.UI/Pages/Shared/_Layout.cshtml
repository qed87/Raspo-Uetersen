<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Stempelkarten</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<header>
    <img src="~/img/rasensport-uetersen-logo.png" class="rounded float-end" style="width: 80px; margin: 10px 10px 10px 10px" alt="rasensport-uetersen-logo"/>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            @* external users open shared stamp cards without login, the navigation is of no use to them *@
            @if (User.Identity?.IsAuthenticated != true)
            {
                <span class="navbar-brand">Stempelkarten</span>
            }
            else
            {
                var restrictedToAccounting = User.IsRestrictedToAccounting();
                <a class="navbar-brand" asp-area="" asp-page="@(restrictedToAccounting ? "/Accounting" : "/Index")">Stempelkarten</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (!restrictedToAccounting)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Index">Teams</a>
                            </li>
                        }
                        @if (User.IsInRole(ClaimsPrincipalExtensions.AccountingRole))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Accounting">Auswertung</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Help">Hilfe</a>
                        </li>
                    </ul>
                    <!-- Angemeldeter Nutzer -->
                    <partial name="_LoginPartial"/>
                </div>
            }
        </div>
    </nav>
</header>
<!-- Loading overlay -->
<div id="loadingOverlay" class="loading-overlay" style="display: none;">
    <div class="spinner-border text-primary" style="width: 4rem; height: 4rem;" role="status">
        <span class="visually-hidden">Laden...</span>
    </div>
    <div class="mt-3">Bitte warten...</div>
</div>

<!-- Document body -->
<div class="container">
    <breadcrumb></breadcrumb>
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; @(DateTime.UtcNow.Year) - Stempelkarten
        Rasensport Uetersen 1926 e. V.
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>