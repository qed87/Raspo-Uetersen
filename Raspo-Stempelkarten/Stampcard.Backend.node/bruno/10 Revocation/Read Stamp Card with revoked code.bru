meta {
  name: Read Stamp Card with revoked code
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/shared/teams/{{teamName}}/stampcard/{{stampCardId}}
  body: none
  auth: none
}

headers {
  X-Share-Code: {{shareCode}}
}

tests {
  test("responds with 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
