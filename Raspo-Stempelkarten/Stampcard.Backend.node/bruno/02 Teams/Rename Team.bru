meta {
  name: Rename Team
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/teams/{{teamId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{teamName}}-renamed",
    "concurrencyToken": {{concurrencyToken}}
  }
}

script:pre-request {
  // The token sent here is outdated once the update succeeded.
  bru.setVar("outdatedConcurrencyToken", bru.getVar("concurrencyToken"));
}

tests {
  test("responds with 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a newer concurrency token", function () {
    expect(res.body.ConcurrencyToken).to.be.greaterThan(bru.getVar("outdatedConcurrencyToken"));
  });
}

docs {
  Admins only. The stream stays team-{teamId}, so the old name can be used again.
}
