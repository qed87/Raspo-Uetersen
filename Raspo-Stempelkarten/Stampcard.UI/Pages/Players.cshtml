@page "/Teams/{Team}/Players"
@using SmartBreadcrumbs.Nodes
@model Players
@tagHelperPrefix x:

@{
    ViewData["Title"] = "Spieler - " + Model.TeamName;
    ViewData["BreadcrumbNode"] = new RazorPageBreadcrumbNode("Players", "Spielerübersicht")
    {
        Parent = new RazorPageBreadcrumbNode("Index", "Startseite"),
        RouteValues = new Dictionary<string, object>
        {
            { "Team", Model.Team }
        }
    };
}

<h2>Spielerverwaltung: @Model.TeamName</h2>

<x:div asp-validation-summary="All" class="alert alert-danger" role="alert">
</x:div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Vorname</th>
            <th scope="col">Nachname</th>
            <th scope="col">Geburtsdatum</th>
            <th scope="col">Status</th>
            <th scope="col"></th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Items.Count > 0)
        {
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                var player = Model.Items[i];
                var itemId = player.Id;
                <tr>
                    <td>@(Model.Offset + i + 1)</td>
                    <td>@player.FirstName</td>
                    <td>@player.LastName</td>
                    <td>@DisplayFormat.Date(player.Birthdate)</td>
                    <td>
                        @if (player.Active)
                        {
                            <span class="badge bg-success">Aktiv</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Deaktiviert</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            <x:a class="btn btn-dark" asp-page="Player" asp-route-team="@Model.Team" asp-route-id="@itemId">
                                <i class="bi bi-person-fill" aria-hidden="true"></i> Spieler bearbeiten
                            </x:a>
                            <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#deleteModal-@itemId">
                                <i class="bi bi-trash3-fill" aria-hidden="true"></i> Spieler löschen
                            </button>
                        </div>
                        <div class="modal fade" id="deleteModal-@itemId" tabindex="-1" aria-labelledby="deleteModalLabel-@itemId" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="deleteModalLabel-@itemId">Wirklich löschen?</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
                                    </div>
                                    <div class="modal-body">
                                        Möchten Sie den <strong>Spieler: @player.LastName, @player.FirstName</strong> endgültig löschen?<br>
                                        @if (player.StampCardCount > 0)
                                        {
                                            <text>
                                                Dabei werden auch
                                                <strong>@(player.StampCardCount == 1 ? "seine Stempelkarte" : $"seine {player.StampCardCount} Stempelkarten")</strong>
                                                mit allen Stempeln und geteilten Links gelöscht.<br>
                                            </text>
                                        }
                                        Diese Aktion kann <strong>nicht</strong> rückgängig gemacht werden.
                                        @if (player.Active)
                                        {
                                            <p class="mt-3 mb-0">
                                                Wenn Sie die Daten behalten möchten, deaktivieren Sie den Spieler stattdessen.
                                                Für deaktivierte Spieler können keine neuen Stempelkarten angelegt werden.
                                            </p>
                                        }
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                                        @if (player.Active)
                                        {
                                            <x:form asp-page-handler="disable" asp-route-id="@itemId" asp-route-pageNumber="@Model.PageNumber" method="post" data-loading="true">
                                                <button type="submit" class="btn btn-primary">Stattdessen deaktivieren</button>
                                            </x:form>
                                        }
                                        <x:form asp-page-handler="delete" asp-route-id="@itemId" asp-route-pageNumber="@Model.PageNumber" method="post" data-loading="true">
                                            <button type="submit" class="btn btn-danger">Endgültig löschen</button>
                                        </x:form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6">Keine Daten</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.PageCount > 1)
{
    <nav aria-label="Seiten der Spielerübersicht">
        <ul class="pagination">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <x:a class="page-link" asp-page="Players" asp-route-team="@Model.Team" asp-route-pageNumber="@(Model.PageNumber - 1)" aria-label="Vorherige Seite">
                    <span aria-hidden="true">&laquo;</span>
                </x:a>
            </li>
            @for (var pageNumber = 1; pageNumber <= Model.PageCount; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")" aria-current="@(pageNumber == Model.PageNumber ? "page" : null)">
                    <x:a class="page-link" asp-page="Players" asp-route-team="@Model.Team" asp-route-pageNumber="@pageNumber">@pageNumber</x:a>
                </li>
            }
            <li class="page-item @(Model.PageNumber == Model.PageCount ? "disabled" : "")">
                <x:a class="page-link" asp-page="Players" asp-route-team="@Model.Team" asp-route-pageNumber="@(Model.PageNumber + 1)" aria-label="Nächste Seite">
                    <span aria-hidden="true">&raquo;</span>
                </x:a>
            </li>
        </ul>
    </nav>
}

<h3 class="mt-4">Spieler anlegen</h3>
<x:form asp-page="" asp-route-pageNumber="@Model.PageNumber" method="post">
    <div class="row g-3 mb-3">
        <div class="col-auto">
            <x:label asp-for="NewPlayer.FirstName" class="form-label">Vorname</x:label>
            <x:input asp-for="NewPlayer.FirstName" class="form-control"/>
            <x:span asp-validation-for="NewPlayer.FirstName" class="text-danger"></x:span>
        </div>
        <div class="col-auto">
            <x:label asp-for="NewPlayer.LastName" class="form-label">Nachname</x:label>
            <x:input asp-for="NewPlayer.LastName" class="form-control"/>
            <x:span asp-validation-for="NewPlayer.LastName" class="text-danger"></x:span>
        </div>
        <div class="col-auto">
            <x:label asp-for="NewPlayer.Birthdate" class="form-label">Geburtsdatum</x:label>
            <x:input asp-for="NewPlayer.Birthdate" class="form-control"/>
            <x:span asp-validation-for="NewPlayer.Birthdate" class="text-danger"></x:span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Anlegen</button>
</x:form>
