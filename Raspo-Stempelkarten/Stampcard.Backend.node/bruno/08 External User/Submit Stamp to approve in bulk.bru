meta {
  name: Submit Stamp to approve in bulk
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/shared/teams/{{teamName}}/stampcard/{{stampCardId}}/stamp
  body: json
  auth: none
}

headers {
  X-Share-Code: {{shareCode}}
}

body:json {
  {
    "reason": "Turnier",
    "issuerName": "Oma Erna"
  }
}

script:post-response {
  bru.setVar("bulkStampId", res.body.Data);
}

tests {
  test("responds with 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
