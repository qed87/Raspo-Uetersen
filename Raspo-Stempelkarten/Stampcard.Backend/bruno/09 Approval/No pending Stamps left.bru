meta {
  name: No pending Stamps left
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/teams/{{teamId}}/stamp/pending
  body: none
  auth: inherit
}

tests {
  test("responds with 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("nothing is pending", function () {
    expect(res.body.Data).to.have.lengthOf(0);
  });
}
