@page "/Teams/{Team}"
@using SmartBreadcrumbs.Nodes
@model Team
@tagHelperPrefix x:

@{
    ViewData["Title"] = (Model.Item?.Name ?? "Team") + " bearbeiten";
    ViewData["BreadcrumbNode"] = new RazorPageBreadcrumbNode("Team", "Team")
    {
        Parent = new RazorPageBreadcrumbNode("Index", "Startseite"),
        RouteValues = new Dictionary<string, object>
        {
            { "Team", Model.Id }
        }
    };
}

<h2>Team @Model.Item?.Name</h2>
<x:form asp-page="" asp-page-handler="team" method="post">
    <x:div asp-validation-summary="All" class="alert alert-danger" role="alert">
    </x:div>
    <div class="mb-3">
        <div class="mb-3">
            <x:label asp-for="NewName" class="form-label">Team-Name</x:label>
            <x:input asp-for="NewName" class="form-control"/>
            <x:input hidden="hidden" asp-for="SetConcurrencyToken"/>
        </div>
        <button class="btn-primary btn">Aktualisieren</button>
    </div>
</x:form>

<h3 class="mt-4">Team-Coaches</h3>
<div class="mb-3 table-responsive">
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Team-Coach</th>
            <th scope="col"></th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Coaches.Count == 0)
        {
            <tr>
                <td colspan="3">Keine Daten</td>
            </tr>
        }
        else
        {
            @for (var i = 0; i < Model.Coaches.Count; i++)
            {
                var itemId = @Model.Coaches[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>
                        @Model.Coaches[i]
                    </td>
                    <td>
                        <x:form asp-page-handler="delete" asp-route-name="@itemId" method="post" data-loading="true">
                            <button type="submit" class="btn btn-dark" data-confirm="Möchten Sie @itemId wirklich als Coach entfernen?">
                                <i class="bi bi-trash3-fill" aria-hidden="true"></i> Coach entfernen
                            </button>
                        </x:form>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

<x:form asp-page="" asp-page-handler="coach" method="post">
    <x:div asp-validation-summary="All" class="alert alert-danger" role="alert">
    </x:div>
    <div class="mb-3">
        <div class="mb-3">
            <x:label asp-for="NewCoach" class="form-label">Coach (E-Mail)</x:label>
            <x:input asp-for="NewCoach" class="form-control"/>
        </div>
        <button class="btn-primary btn">Hinzufügen</button>
    </div>
</x:form>